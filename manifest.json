{
  "manifest_version": 3,
  "name": "YouTube Speed Booster",
  "version": "2.0",
  "description": "Select YouTube playback speed via a dropdown menu.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
